msgstr "Todos os pacientes"

#: core/settings.py:1471
msgid "Only patients created by myself"
msgstr "Somente pacientes criados por mim"

#: core/settings.py:1472
msgid "Patients of same organization"
msgstr "Pacientes da mesma organização"

#: core/settings.py:1481
msgid "Tiny (~1 GB, very fast, low accuracy)"
msgstr "Tiny (~1 GB, muito rápido, baixa precisão)"

#: core/settings.py:1482
msgid "Base (~1 GB, fast, acceptable accuracy)"
msgstr "Base (~1 GB, rápido, precisão aceitável)"

#: core/settings.py:1483
msgid "Small (~2 GB, good balance)"
msgstr "Small (~2 GB, bom equilíbrio)"

#: core/settings.py:1484
msgid "Medium (~5 GB, slower, great accuracy)"
msgstr "Medium (~5 GB, mais lento, ótima precisão)"

#: core/settings.py:1485
msgid "Large v3 (~10 GB, best accuracy, GPU recommended)"
msgstr "Large v3 (~10 GB, melhor precisão, GPU recomendada)"

#: core/settings.py:1511
msgid "Sunday"
msgstr "Domingo"

#: core/settings.py:1512
msgid "Monday"
msgstr "Segunda-feira"

#: core/settings.py:1513
msgid "Tuesday"
msgstr "Terça-feira"

